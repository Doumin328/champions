{
  "name": "champions_ts",
  "version": "0.1.0",
  "description": "Electron デスクトップアプリ",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/renderer/*.html\" \"src/renderer/*.css\" \"src/renderer/data/*.json\" dist && copyfiles -u 1 \"src/img/*\" \"src/img/pokemon/*\" \"src/img/pokemon2/*\" \"src/img/pokemon3/*\" \"src/img/pokemon_cs/*\" \"src/img/type/*\" \"src/img/type/logos/*\" \"src/img/type/sv/*\" \"src/img/item/*\" dist/renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "format-moves-info": "node scripts/format-moves-info.js",
    "update-moves": "node scripts/update-moves.js",
    "update-learnsets": "node scripts/update-learnsets.js",
    "update-learnsets-from-info": "node scripts/update-learnsets-from-info.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "copyfiles": "^2.4.1",
    "electron": "^28.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
